DIALOG 10 "Taskmanager" 0 0 240 140
  LIST                  40   8   8 224 92 WS_VSCROLL
  STATIC   ""           41   8 104 224 10
  BUTTON   "&Beenden"   21   8 118  70 14
  BUTTON   "&Aktualisieren" 22  84 118  80 14
